---
import { Image } from 'astro:assets';
import portrait from '../assets/portrait.jpg';
import Base from '../layouts/Base.astro';
import ProfileLinks from '../components/ProfileLinks.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, cv } from '../lib/data';
import { getNews, getProjects, getThemes } from '../lib/content';
import { heroImage } from '../lib/images';
import { renderIntro } from '../lib/intro';
import { formatDatePrecise, isoDate } from '../lib/dates';
import { href, absoluteUrl } from '../lib/url';

const themes = await getThemes();
const projects = await getProjects();
const active = projects.filter((p) => p.data.status === 'active');
const featured = active.filter((p) => p.data.featured);
const current = (featured.length ? featured : active).slice(0, 4);
const news = (await getNews()).slice(0, 6);
const hero = heroImage();

// schema.org Person
const edu = cv.sections.find((s) => s.id === 'education')?.items ?? [];
const strip = (s: string) => s.replace(/<[^>]+>/g, '');
const alumniOf = edu
  .map((i) => strip(i.title ?? '').split(',').map((x) => x.trim()).find((x) => /univers|institut|college|inaoe/i.test(x)))
  .filter((x): x is string => !!x)
  .map((name) => ({ '@type': 'EducationalOrganization', name }));
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.fullName ?? site.name,
  jobTitle: site.role,
  url: absoluteUrl('/', Astro.site),
  image: new URL(portrait.src, Astro.site).href,
  ...(site.address[0] ? { affiliation: { '@type': 'Organization', name: site.address[0] } } : {}),
  ...(alumniOf.length ? { alumniOf } : {}),
  ...(site.phone ? { telephone: site.phone } : {}),
  sameAs: site.profiles.map((p) => p.url),
  knowsAbout: themes.map((t) => t.data.title),
};
---
<Base jsonLd={jsonLd}>
  <section class:list={['hero-band', { 'has-image': !!hero }]} aria-labelledby="home-title">
    {hero && <Image src={hero} alt="" width={Math.min(2400, hero.width)} widths={[1200, 1800, 2400].filter((w) => w <= hero.width)} sizes="100vw" loading="eager" fetchpriority="high" decoding="async" />}
    <div>
      <h1 id="home-title">{site.name}</h1>
      <p>Astrophysicist · {site.shortAffiliation ?? 'INAOE, Mexico'}</p>
    </div>
    {hero && site.heroCredit && <p class="hero-credit">{site.heroCredit}</p>}
  </section>

  <div class="wrap">
    <section class="intro" aria-label="About">
      <figure class="intro-portrait">
        <Image src={portrait} alt={`Portrait of ${site.name}`} width={Math.min(600, portrait.width)} widths={[300, 600].filter((w) => w <= portrait.width)} sizes="(min-width: 640px) 300px, 92vw" loading="eager" decoding="async" />
      </figure>
      <div class="intro-text">
        {site.role && <p class="position">{site.role}, {site.shortAffiliation ?? 'INAOE, Mexico'}</p>}
        {site.intro && <p class="statement" set:html={renderIntro(site.intro)} />}
        <ProfileLinks />
      </div>
    </section>

    {current.length > 0 && (
      <section class="section" aria-labelledby="h-projects">
        <h2 id="h-projects">Current projects</h2>
        <ul class="cards">
          {current.map((p) => <ProjectCard project={p} />)}
        </ul>
      </section>
    )}

    {news.length > 0 && (
      <section class="section" aria-labelledby="h-news">
        <h2 id="h-news">News</h2>
        <ul class="row-list">
          {news.map((n) => (
            <li>
              <time datetime={isoDate(n.data.date)}>{formatDatePrecise(n.data.date, n.data.datePrecision)}</time>
              <span>{n.data.url ? <a href={n.data.url} rel="noopener" lang={n.data.lang}>{n.data.title}</a> : <a href={href('/news/')} lang={n.data.lang}>{n.data.title}</a>}</span>
            </li>
          ))}
        </ul>
        <p class="more"><a href={href('/news/')}>More news</a></p>
      </section>
    )}
  </div>
</Base>
